# Public Supabase project configuration. Never use a service-role key here.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Older projects can use VITE_SUPABASE_ANON_KEY instead; both names are supported.

# GEMINI_API_KEY belongs ONLY in the deployed generate-questions Edge Function's
# server-side secrets. Do not add it (or a VITE_ variant) to this client app.
